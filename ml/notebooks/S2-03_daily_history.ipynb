   "source": [
    "counts.loc[counts['period'] == 'historical', 'HR'].sum()"
    "# Weekday: the average number of tickets on each day of the week.\n",
    "weekday = daily.groupby(daily.index.dayofweek).mean().round(1)\n",
    "weekday.index = [\"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\", \"Sun\"]\n",
    "\n",
    "# Month-end: weekdays from the 25th to the end of the month, against other weekdays\n",
    "# (payslips and invoices make month-end busier).\n",
    "weekdays_only = daily[daily.index.dayofweek < 5]\n",
    "month_end = weekdays_only[weekdays_only.index.day >= 25].mean()\n",
    "rest = weekdays_only[weekdays_only.index.day < 25].mean()\n",
    "month_end_factor = (month_end / rest).round(2)\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
    "weekday.plot.bar(ax=axes[0], title=\"Average tickets by weekday\")\n",
    "axes[0].set_ylabel(\"tickets per day\")\n",
    "pd.DataFrame({\"25th to month-end\": month_end, \"1st to 24th\": rest}).round(1).plot.bar(\n",
    "    ax=axes[1], title=\"Weekdays: month-end against the rest of the month\"\n",
    ")\n",
    "for ax in axes:\n",
    "    ax.tick_params(axis=\"x\", rotation=0)\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"docs/forecast/patterns.png\", dpi=150)\n",
    "plt.show()\n",
    "\n",
    "print(\"Month-end factor (25th onwards ÷ other weekdays):\", month_end_factor.to_dict())\n",
    "weekday"
   ]
  },
