    "import os\n",
    "from pathlib import Path\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "\n",
    "# Work from the repo root, wherever the notebook was opened from.\n",
    "if Path(\"../../data/processed/combined_tickets.csv\").exists():\n",
    "    os.chdir(\"../..\")  # opened from ml/notebooks inside the repo\n",
    "elif not Path(\"data/processed/combined_tickets.csv\").exists():\n",
    "    if not Path(\"relay\").exists():\n",
    "        os.system(\"git clone --depth 1 https://github.com/mngadisamu/relay.git\")\n",
    "    os.chdir(\"relay\")\n",
    "print(\"Working in the repo folder:\", Path.cwd().name)\n",
    "\n",
    "DEPARTMENTS = [\"HR\", \"IT\", \"Finance\", \"Operations\"]\n",
    "START, END = pd.Timestamp(\"2025-10-19\"), pd.Timestamp(\"2026-10-18\")  # the year of past tickets\n",
    "\n",
    "tickets = pd.read_csv(\"data/processed/combined_tickets.csv\", usecols=[\"reference\", \"department\", \"created_at\"])\n",
    "# created_at is stored with its time zone; turn it into the calendar day in Johannesburg.\n",
    "tickets[\"day\"] = (\n",
    "    pd.to_datetime(tickets[\"created_at\"], utc=True).dt.tz_convert(\"Africa/Johannesburg\").dt.tz_localize(None).dt.normalize()\n",
    ")\n",
    "print(f\"{len(tickets):,} past tickets, {tickets['day'].min().date()} to {tickets['day'].max().date()}\")\n",
    "tickets[\"department\"].value_counts().reindex(DEPARTMENTS)"
   ]
  },
