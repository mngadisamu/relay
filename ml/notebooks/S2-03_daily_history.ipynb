   "source": [
    "today = pd.Timestamp.now(tz='Africa/Johannesburg').tz_localize(None).normalize()\n",
    "\n",
    "hist_days = tickets.loc[tickets['is_historical'], 'day']\n",
    "live_days = tickets.loc[~tickets['is_historical'], 'day']\n",
    "hist_end = hist_days.max()\n",
    "live_start = live_days.min()\n",
    "\n",
    "start = tickets['day'].min()\n",
    "days = pd.date_range(start, today, freq='D')\n",
    "\n",
    "def period_of(d):\n",
    "    if d <= hist_end:\n",
    "        return 'historical'\n",
    "    if d < live_start:\n",
    "        return 'gap'\n",
    "    return 'live'\n",
    "\n",
    "counts = (\n",
    "    tickets.groupby(['day', 'department'])\n",
    "    .size()\n",
    "    .unstack('department')\n",
    "    .reindex(days, fill_value=0)\n",
    "    .fillna(0)\n",
    "    .astype(int)\n",
    ")\n",
    "counts.index.name = 'day'\n",
    "counts.insert(0, 'period', [period_of(d) for d in counts.index])\n",
    "\n",
    "counts.to_csv(DATA / 'daily_counts.csv')\n",
    "print('Historical ends', hist_end.date(), '| live starts', live_start.date(), '| today', today.date())\n",
    "counts.tail(10)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
    "days = pd.date_range(START, END, freq=\"D\")\n",
    "daily = (\n",
    "    tickets.groupby([\"day\", \"department\"]).size()\n",
    "    .unstack(\"department\")\n",
    "    .reindex(index=days, columns=DEPARTMENTS)\n",
    "    .fillna(0)\n",
    "    .astype(int)\n",
    ")\n",
    "daily.index.name = \"day\"\n",
    "\n",
    "# Saved in the repo, so the forecast (S2-08) and its tests can use exactly these numbers.\n",
    "daily.to_csv(\"data/processed/daily_counts.csv\")\n",
    "daily.head()"
   ]
