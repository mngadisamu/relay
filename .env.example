# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (server-side only, never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=

# Monday summary job (S2-34). Vercel sends it as the Bearer token. Set the same value in
# migration 0019 (cron_secret). Server only, never prefix with NEXT_PUBLIC_.
CRON_SECRET=

# Resend Email Notifications (S4-10). Server only.
RESEND_API_KEY=
# Sender shown on emails. Use an address on a domain you have verified in Resend.
RESEND_FROM=
# The live address, used for the link in each email.
APP_URL=https://relay-gilt-nine.vercel.app

# Kopano Freight demo (fictional company). Off unless DEMO_ENABLED=true. Server only.
# Each role needs an email and password. Passwords never go to the browser.
# Company addresses (P7): with a domain you own, e.g. relay.example, each company gets kopano.relay.example.
# Leave blank until the wildcard domain is set up in Vercel.
RELAY_BASE_DOMAIN=
DEMO_ENABLED=
DEMO_ACCOUNT_EMAILS=
DEMO_GEMINI_DAILY_LIMIT=50
DEMO_STAFF_EMAIL=
DEMO_STAFF_PASSWORD=
DEMO_AGENT_IT_EMAIL=
DEMO_AGENT_IT_PASSWORD=
DEMO_AGENT_HR_EMAIL=
DEMO_AGENT_HR_PASSWORD=
DEMO_AGENT_FINANCE_EMAIL=
DEMO_AGENT_FINANCE_PASSWORD=
DEMO_AGENT_OPERATIONS_EMAIL=
DEMO_AGENT_OPERATIONS_PASSWORD=
DEMO_DEPARTMENT_MANAGER_EMAIL=
DEMO_DEPARTMENT_MANAGER_PASSWORD=
DEMO_GENERAL_MANAGER_EMAIL=
DEMO_GENERAL_MANAGER_PASSWORD=
DEMO_COMPLIANCE_EMAIL=
DEMO_COMPLIANCE_PASSWORD=