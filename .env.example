# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (server-side only, never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=

# Monday summary job (S2-34). Vercel sends it as the Bearer token. Set the same value in
# migration 0019 (cron_secret). Server only, never prefix with NEXT_PUBLIC_.
CRON_SECRET=
