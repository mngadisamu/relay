# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (server-side only, never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=

# Monday summary job (S2-34). Vercel sends it as the Bearer token. Set the same value in
# migration 0019 (cron_secret). Server only, never prefix with NEXT_PUBLIC_.
CRON_SECRET=

# Resend Email Notifications (S4-10). Server only.
RESEND_API_KEY=
# Sender shown on emails. Use an address on a domain you have verified in Resend.
RESEND_FROM=
# The live address, used for the link in each email.
APP_URL=https://relay-gilt-nine.vercel.app